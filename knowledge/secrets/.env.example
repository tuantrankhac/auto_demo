# Jira / Xray secrets — KHÔNG commit file .env thật vào git
#
# Cách dùng:
#   1. Copy file này thành .env
#   2. Điền giá trị thật
#   3. Jira MCP sẽ load từ knowledge/secrets/.env
#
# Lấy Jira API Token (Cloud):
#   https://id.atlassian.com/manage-profile/security/api-tokens

# Bắt buộc — dùng cho knowledge/config/jira.yaml → apiToken: ${JIRA_API_TOKEN}
JIRA_API_TOKEN=your_atlassian_api_token_here

# Tuỳ chọn — Xray Cloud (khi testManagement: xray)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Tuỳ chọn — override URL/email nếu không muốn sửa jira.yaml
# JIRA_BASE_URL=https://company.atlassian.net
# JIRA_EMAIL=automation@company.com
